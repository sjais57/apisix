curl -X PUT http://127.0.0.1:9180/apisix/admin/routes/2001 \
  -H "X-API-KEY: <your-admin-key>" \
  -H "Content-Type: application/json" \
  -d '{
    "uri": "/fd/sas2py/triton/generate",
    "methods": ["POST"],
    "upstream": {
      "type": "roundrobin",
      "scheme": "https",
      "nodes": {
        "upstream:port": 1
      },
      "pass_host": "rewrite",
      "upstream_host": "upstream"
    },
    "plugins": {
      "proxy-rewrite": {
        "regex_uri": ["/fd/sas2py/triton/generate", "/sas2py/triton/generate"]
      }
    }
  }'
